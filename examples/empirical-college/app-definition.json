      "name": "Ask for support",
      "entity": "incident",
      "layout": "form",
      "messagingEnabled": false,
      "mediaEnabled": false,
      "sections": [
        {
          "id": "main",
          "label": "Tell us what's going on",
          "order": 1
        }
      ],
      "fields": [
        {
          "name": "ec_category",
          "label": "What is it about?",
          "type": "optionset",
          "section": "main",
          "crmField": true,
          "required": true,
          "showOnCreate": true,
          "showOnView": true,
          "order": 1,
          "options": [
            {
              "value": "1",
              "label": "Anxiety or low mood",
              "order": 1
            },
            {
              "value": "2",
              "label": "Academic stress",
              "order": 2
            },
            {
              "value": "3",
              "label": "Financial worries",
              "order": 3
            },
            {
              "value": "4",
              "label": "Housing",
              "order": 4
            },
            {
              "value": "5",
              "label": "Harassment or bullying",
              "order": 5
            },
            {
              "value": "6",
              "label": "Disability support",
              "order": 6
            },
            {
              "value": "7",
              "label": "Alcohol or substance use",
              "order": 7
            },
            {
              "value": "8",
              "label": "Something else",
              "order": 8
            }
          ]
        },
        {
          "name": "description",
          "label": "What's going on?",
          "type": "textarea",
          "section": "main",
          "crmField": true,
          "required": true,
          "showOnCreate": true,
          "showOnView": true,
          "order": 2,
          "maxLength": 2000
        },
        {
          "name": "ec_urgency",
          "label": "How urgent is it?",
          "type": "optionset",
          "section": "main",
          "crmField": true,
          "required": true,
          "showOnCreate": true,
          "showOnView": true,
          "order": 3,
          "options": [
            {
              "value": "1",
              "label": "I need help today",
              "order": 1
            },
            {
              "value": "2",
              "label": "Within a few days",
              "order": 2
            },
            {
              "value": "3",
              "label": "No rush",
              "order": 3
            }
          ]
        },
        {
          "name": "ec_hasrelated",
          "label": "Is this about an earlier request?",
          "type": "boolean",
          "section": "main",
          "crmField": false,
          "required": false,
          "showOnCreate": true,
          "showOnView": true,
          "order": 4
        },
        {
          "name": "ec_relatedrequestid",
          "label": "Which request?",
          "type": "lookup",
          "section": "main",
          "crmField": true,
          "required": false,
          "showOnCreate": true,
          "showOnView": true,
          "order": 5,
          "lookupConfig": {
            "listScreenId": "my_wellbeing_list"
          },
          "rules": [
            {
              "action": "hide",
              "condition": "and",
              "rules": [
                {
                  "dependsOn": "ec_hasrelated",
                  "operator": "isFalse"
                }
              ]
            }
          ]
        },
        {
          "name": "ec_consentgiven",
          "label": "I agree to the wellbeing team using this to support me",
          "type": "boolean",
          "section": "main",
          "crmField": true,
          "required": true,
          "showOnCreate": true,
          "showOnView": true,
          "order": 6
        }
      ],
      "createEndpointIds": [
        "submit_wellbeing"
      ],
      "updateEndpointIds": [
        "book_appointment"
      ]
