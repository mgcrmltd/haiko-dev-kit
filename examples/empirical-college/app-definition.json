        "name": "Placement year",
        "entity": "ec_placement",
        "defaultMessage": "We're looking at your placement.",
        "defaultContactAction": "waiting",
        "stages": [
          {
            "id": "not_approved",
            "label": "Not approved",
            "order": 0,
            "pathRole": "terminal",
            "activeWhen": "ec_outcome == 4",
            "completeWhen": "isEmpty(createdon)",
            "message": "We couldn't approve this placement. Your placements team will explain why and what you can do next.",
            "contactAction": "none"
          },
          {
            "id": "withdrawn",
            "label": "Withdrawn",
            "order": 0,
            "pathRole": "terminal",
            "activeWhen": "ec_outcome == 3",
            "completeWhen": "isEmpty(createdon)",
            "message": "This placement was withdrawn.",
            "contactAction": "none"
          },
          {
            "id": "proposed",
            "label": "Proposed",
            "order": 1,
            "activeWhen": "isEmpty(createdon)",
            "completeWhen": "hasValue(createdon)",
            "message": "",
            "dateField": "createdon"
          },
          {
            "id": "checking",
            "label": "Employer check",
            "order": 2,
            "activeWhen": "isEmpty(ec_vettedon)",
            "completeWhen": "hasValue(ec_vettedon)",
            "message": "We've got your proposal. We're confirming {ec_employername}'s insurance and health and safety.",
            "contactAction": "waiting",
            "dateField": "ec_vettedon",
            "showFields": [
              "ec_employername",
              "ec_roletitle",
              "ec_startdate",
              "ec_enddate",
              "ec_supervisorname"
            ],
            "readOnlyFields": [
              "ec_employername",
              "ec_roletitle",
              "ec_startdate",
              "ec_enddate",
              "ec_supervisorname"
            ]
          },
          {
            "id": "documents",
            "label": "Documents",
            "order": 3,
            "activeWhen": "hasValue(ec_vettedon) AND isEmpty(ec_documentscompleteon)",
            "completeWhen": "hasValue(ec_documentscompleteon)",
            "message": "We need three documents: your offer letter, insurance certificate and DBS check.",
            "contactAction": "action_required",
            "dateField": "ec_documentscompleteon",
            "showFields": [
              "ec_offerletter",
              "ec_insurancecert",
              "ec_dbscheck"
            ]
          },
          {
            "id": "agreement",
            "label": "Learning agreement",
            "order": 4,
            "activeWhen": "hasValue(ec_documentscompleteon) AND isEmpty(ec_agreementsignedon)",
            "completeWhen": "hasValue(ec_agreementsignedon)",
            "message": "Read your learning agreement, then confirm you've signed it.",
            "contactAction": "action_required",
            "dateField": "ec_agreementsignedon",
            "showFields": [
              "ec_learningagreement"
            ],
            "readOnlyFields": [
              "ec_learningagreement"
            ],
            "action": {
              "type": "confirm",
              "label": "I've signed it",
              "endpointId": "sign_agreement",
              "confirmMessage": "Confirm you have read your learning agreement and signed it."
            }
          },
          {
            "id": "approval",
            "label": "Final approval",
            "order": 5,
            "activeWhen": "hasValue(ec_agreementsignedon) AND isEmpty(ec_approvedon)",
            "completeWhen": "hasValue(ec_approvedon)",
            "message": "Thanks for signing. We're giving your placement its final approval.",
            "contactAction": "waiting",
            "dateField": "ec_approvedon"
          },
          {
            "id": "approved",
            "label": "Approved",
            "order": 6,
            "activeWhen": "hasValue(ec_approvedon) AND isFuture(ec_startdate)",
            "completeWhen": "hasValue(ec_approvedon) AND NOT isFuture(ec_startdate)",
            "message": "You're all set. Your placement starts soon.",
            "contactAction": "none",
            "showFields": [
              "ec_startdate"
            ],
            "readOnlyFields": [
              "ec_startdate"
            ]
          },
          {
            "id": "on_placement",
            "label": "On placement",
            "order": 7,
            "activeWhen": "hasValue(ec_approvedon) AND NOT isFuture(ec_startdate) AND isFuture(ec_enddate)",
            "completeWhen": "isPast(ec_enddate) OR hasValue(ec_finalreportreceivedon)",
            "message": "Three check-ins across the year. We'll ask when each is due.",
            "contactAction": "none",
            "action": {
              "type": "navigate",
              "label": "See my check-ins",
              "screenId": "my_checkins_list"
            }
          },
          {
            "id": "final_report",
            "label": "Final report",
            "order": 8,
            "activeWhen": "hasValue(ec_approvedon) AND isPast(ec_enddate) AND isEmpty(ec_finalreportreceivedon)",
            "completeWhen": "hasValue(ec_finalreportreceivedon)",
            "message": "One last thing: your reflective report on the year.",
            "contactAction": "action_required",
            "dateField": "ec_finalreportreceivedon",
            "showFields": [
              "ec_finalreport"
            ]
          },
          {
            "id": "report_received",
            "label": "Report received",
            "order": 9,
            "activeWhen": "hasValue(ec_finalreportreceivedon) AND isEmpty(ec_outcome)",
            "completeWhen": "hasValue(ec_outcome)",
            "message": "Thanks. Your tutor will record the outcome.",
            "contactAction": "waiting"
          },
          {
            "id": "completed",
            "label": "Completed",
            "order": 10,
            "activeWhen": "ec_outcome == 1 OR ec_outcome == 2",
            "completeWhen": "ec_outcome == 1 OR ec_outcome == 2",
            "message": "Placement complete. Your outcome is recorded.",
            "contactAction": "none",
            "showFields": [
              "ec_outcome"
            ],
            "readOnlyFields": [
              "ec_outcome"
            ]
          }
        ]
      }
    },
    {
      "type": "list",
      "id": "my_checkins_list",
      "name": "My check-ins",
      "entity": "ec_placementcheckin",
      "layout": "detailed",
      "customerField": "ec_studentid",
      "titleField": "ec_placementcheckinname",
      "subtitleField": "ec_placementid",
      "dateField": "ec_duedate",
      "allowCreate": false,
      "detailScreenId": "checkin_detail",
      "iconField": "statuscode",
      "defaultIcon": "clipboard-text",
      "defaultIconColor": "#C2410C"
    },
    {
      "type": "record",
      "id": "checkin_detail",
      "name": "Check-in",
      "entity": "ec_placementcheckin",
      "layout": "detail",
      "titleField": "ec_placementcheckinname",
      "subtitleField": "ec_placementid",
      "timelineEnabled": false,
      "messagingEnabled": false,
      "mediaEnabled": false,
      "actionEndpointIds": [],
      "sections": [
        {
          "id": "main",
          "label": "Check-in",
          "order": 1
        }
      ],
      "fields": [
        {
          "name": "ec_duedate",
          "label": "Due",
          "type": "date",
          "section": "main",
          "crmField": true,
          "required": false,
          "showOnCreate": true,
          "showOnView": true,
          "order": 1
        },
        {
          "name": "ec_response",
          "label": "How has the placement been this term?",
          "type": "textarea",
          "section": "main",
          "crmField": true,
          "required": false,
          "showOnCreate": true,
          "showOnView": true,
          "order": 2,
          "maxLength": 4000
        }
      ],
      "journey": {
        "id": "checkin",
        "name": "Check-in",
        "entity": "ec_placementcheckin",
        "defaultMessage": "We'll let you know when this is due.",
        "defaultContactAction": "none",
        "stages": [
          {
            "id": "overdue",
            "label": "Overdue",
            "order": 0,
            "pathRole": "exception",
            "appliesWhen": "isPast(ec_duedate) AND isEmpty(ec_submittedon)",
            "activeWhen": "isPast(ec_duedate) AND isEmpty(ec_submittedon)",
            "completeWhen": "hasValue(ec_submittedon)",
            "message": "This is past its due date. Tell us how it's going as soon as you can.",
            "contactAction": "action_required",
            "showFields": [
              "ec_response"
            ]
          },
          {
            "id": "not_open",
            "label": "Not due yet",
            "order": 1,
            "activeWhen": "isFuture(ec_openson) AND isEmpty(ec_submittedon)",
            "completeWhen": "isPast(ec_openson) OR hasValue(ec_submittedon)",
            "message": "Nothing to do yet. We'll ask you nearer the time.",
            "contactAction": "none",
            "showFields": [
              "ec_duedate"
            ],
            "readOnlyFields": [
              "ec_duedate"
            ]
          },
          {
            "id": "due",
            "label": "Due",
            "order": 2,
            "appliesWhen": "NOT (isPast(ec_duedate) AND isEmpty(ec_submittedon))",
            "activeWhen": "isEmpty(ec_submittedon)",
            "completeWhen": "hasValue(ec_submittedon)",
            "message": "Tell us how it's going, then save.",
            "contactAction": "action_required",
            "showFields": [
              "ec_duedate",
              "ec_response"
            ],
            "readOnlyFields": [
              "ec_duedate"
            ]
          },
          {
            "id": "submitted",
            "label": "Submitted",
            "order": 3,
            "activeWhen": "hasValue(ec_submittedon) AND isEmpty(ec_reviewedon)",
            "completeWhen": "hasValue(ec_reviewedon)",
            "message": "Thanks. Your tutor will read this.",
            "contactAction": "waiting",
            "dateField": "ec_submittedon"
          },
          {
            "id": "reviewed",
            "label": "Reviewed",
            "order": 4,
            "activeWhen": "hasValue(ec_reviewedon)",
            "completeWhen": "hasValue(ec_reviewedon)",
            "message": "Your tutor has read it.",
            "contactAction": "none",
            "dateField": "ec_reviewedon"
          }
        ]
      }
    }
  ],
