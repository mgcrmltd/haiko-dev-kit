      "journey": {
        "id": "wellbeing",
        "name": "Wellbeing request",
        "entity": "incident",
        "defaultMessage": "We're looking at your request.",
        "defaultContactAction": "waiting",
        "stages": [
          {
            "id": "withdrawn",
            "label": "Withdrawn",
            "order": 0,
            "pathRole": "terminal",
            "activeWhen": "statuscode == 450000007",
            "completeWhen": "isEmpty(createdon)",
            "message": "You withdrew this request. You can ask for support again at any time.",
            "contactAction": "none"
          },
          {
            "id": "received",
            "label": "Request received",
            "order": 1,
            "activeWhen": "isEmpty(ec_advisorid)",
            "completeWhen": "hasValue(createdon)",
            "message": "We've got it. Someone will look at this shortly.",
            "contactAction": "waiting",
            "dateField": "createdon",
            "showFields": [
              "ec_category",
              "description",
              "ec_urgency"
            ],
            "readOnlyFields": [
              "ec_category",
              "description",
              "ec_urgency"
            ]
          },
          {
            "id": "assigned",
            "label": "Advisor assigned",
            "order": 2,
            "activeWhen": "hasValue(ec_advisorid) AND isEmpty(ec_appointmenton) AND statuscode != 450000003",
            "completeWhen": "hasValue(ec_advisorid)",
            "message": "{ec_advisorid.name} will be in touch to arrange a time.",
            "contactAction": "waiting"
          },
          {
            "id": "choose",
            "label": "Choose an appointment",
            "order": 3,
            "activeWhen": "hasValue(ec_advisorid) AND isEmpty(ec_appointmenton) AND statuscode == 450000003",
            "completeWhen": "hasValue(ec_appointmenton)",
            "message": "Pick a time that suits you with {ec_advisorid.name}, then save.",
            "contactAction": "action_required",
            "showFields": [
              "ec_appointmentslot",
              "ec_appointmenton"
            ],
            "readOnlyFields": [
              "ec_appointmenton"
            ]
          },
          {
            "id": "booked",
            "label": "Appointment booked",
            "order": 4,
            "activeWhen": "hasValue(ec_appointmenton) AND isEmpty(ec_supportstartedon)",
            "completeWhen": "hasValue(ec_appointmenton)",
            "message": "Your appointment is confirmed.",
            "contactAction": "none",
            "showFields": [
              "ec_appointmenton",
              "ec_appointmentmode",
              "ec_appointmentlocation"
            ],
            "readOnlyFields": [
              "ec_appointmenton",
              "ec_appointmentmode",
              "ec_appointmentlocation"
            ]
          },
          {
            "id": "support",
            "label": "Support in place",
            "order": 5,
            "activeWhen": "hasValue(ec_supportstartedon) AND isEmpty(ec_closedon)",
            "completeWhen": "hasValue(ec_supportstartedon)",
            "message": "We're working with you. Your advisor will be in touch.",
            "contactAction": "none",
            "dateField": "ec_supportstartedon"
          },
          {
            "id": "closed",
            "label": "Closed",
            "order": 6,
            "activeWhen": "hasValue(ec_closedon)",
            "completeWhen": "hasValue(ec_closedon)",
            "message": "This request is closed. You can ask for support again at any time.",
            "contactAction": "none",
            "dateField": "ec_closedon"
          }
        ]
      }
    },
