# Haiko's plugin packages come from Haiko Studio, with your Studio API key (any key; set HAIKO_STUDIO_API_KEY in your environment).
@mgcrm-haiko-builds:registry=https://mgcrm-haiko-portal.azurewebsites.net/api/v1/npm/
//mgcrm-haiko-portal.azurewebsites.net/api/v1/npm/:_authToken=${HAIKO_STUDIO_API_KEY}
