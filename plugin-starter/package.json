  "devDependencies": {
    "@mgcrm-haiko-builds/plugin-tools": "^0.2.0",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "adm-zip": "^0.5.16",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
