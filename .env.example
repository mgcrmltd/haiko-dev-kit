# Copy to .env (never committed) and fill in.

# Your Dynamics 365 / Dataverse URL
HAIKO_CRM_URL=https://yourorg.crm11.dynamics.com

# Your Microsoft Entra tenant (the one you sign in to Dynamics with). Optional
# if `az login` already uses it.
HAIKO_TENANT_ID=

# Haiko Studio
HAIKO_STUDIO_URL=https://mgcrm-haiko-portal.azurewebsites.net
HAIKO_STUDIO_ORG=
# Studio -> Settings -> API keys. Draft-write is enough; keys can't publish.
HAIKO_STUDIO_API_KEY=
